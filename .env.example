# ============================================================
# FleetForge — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=local
APP_URL=http://localhost/fleetforge
APP_DEBUG=true
APP_TIMEZONE=America/Vancouver

# Version tracking [PASS-12:M1]
FF_VERSION=1.0.0
FF_ASSET_VERSION=1.0.0

# Secret key — used for CSRF token generation and session hardening
# Generate with: openssl rand -hex 32
APP_SECRET=

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fleetforge
DB_USERNAME=fleetforge_user
DB_PASSWORD=

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
# Inactivity timeout in seconds (8 hours = 28800)
SESSION_LIFETIME=28800

# ------------------------------------------------------------
# Storage (D9)
# STORAGE_DRIVER=local  → files stored in storage/uploads/ (dev)
# STORAGE_DRIVER=s3     → files go to Amazon S3 (production)
# ------------------------------------------------------------
STORAGE_DRIVER=local

# ------------------------------------------------------------
# AWS — S3 & SES (D9, D10) [INFRA]
# Required when STORAGE_DRIVER=s3 or email is sent via SES
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Per-deployment — MUST be this deployment's own bucket. Never share a bucket
# between deployments: cron/backup_storage.php tars the ENTIRE bucket root, so a
# shared bucket puts one company's customer documents into the other's backup.
AWS_S3_BUCKET=CHANGE_ME-your-bucket-name

# AWS SES SMTP credentials (D10) [INFRA]
AWS_SES_SMTP_HOST=email-smtp.us-west-2.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASS=

# Email sender identity
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=CHANGE_ME Your Company Name

# ------------------------------------------------------------
# GPS — Samsara (tracking URL + mileage only)
# ------------------------------------------------------------
GPS_SAMSARA_API_KEY=
GPS_SAMSARA_ORG_ID=

# ------------------------------------------------------------
# AI — Anthropic (Phase 12+, disabled until platform has data)
# ------------------------------------------------------------
AI_ANTHROPIC_API_KEY=
AI_ENABLED=false
AI_DAILY_TOKEN_LIMIT=500000

# ------------------------------------------------------------
# MFA — TOTP secret encryption key (S-PROD-1A)
# Generate with: openssl rand -hex 32
# REQUIRED when any user enables MFA. Never commit this value.
# ------------------------------------------------------------
FF_MFA_SECRET_KEY=

# ------------------------------------------------------------
# Sentry — Error monitoring (S-PROD-2 / #19)
# Leave SENTRY_DSN blank in dev — no events sent, zero overhead.
# Populate in production with the DSN from your Sentry project.
# ------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------
# AWS SNS — SES bounce/complaint notifications (S-PROD-2 / #21)
# The SNS topic ARN that SES publishes bounce/complaint events to.
#
# SECURITY (S-NORTHLAND-P0): this is the allowlist enforced by
# api/v1/webhooks/ses_notifications.php. An SNS signature only proves AWS sent
# the message — AWS signs for every account — so without this pin, any AWS
# customer can subscribe our webhook to their own topic and publish forged
# bounces that disable our customers' email. SET THIS IN PRODUCTION.
# The `aws.sns_topic_arn` setting takes precedence over this value.
# Format: arn:aws:sns:<region>:<account-id>:<topic-name>
# ------------------------------------------------------------
AWS_SNS_TOPIC_ARN=

# ------------------------------------------------------------
# Maintenance mode
# Comma-separated IPs that can bypass maintenance mode
# ------------------------------------------------------------
MAINTENANCE_BYPASS_IPS=127.0.0.1
