# ============================================================
# FleetForge — .gitignore
# ============================================================

# --- Secrets — NEVER commit ---
.env
*.pem
*.key

# --- Composer / npm ---
vendor/
node_modules/
# Front-end vendor (self-hosted JS/CSS libraries) is committed — do not ignore
!public/assets/vendor/

# --- Storage — user uploads and generated files (go to S3 in prod) ---
storage/uploads/
storage/generated/
storage/documents/
storage/branding/
storage/maintenance.flag
# mPDF runtime font-metrics cache (regenerated on demand; never source)
storage/tmp/

# --- Office documents (specs / references kept locally, not in repo) ---
*.docx

# --- Logs ---
logs/*.log

# --- Cache ---
cache/*
!cache/.gitkeep

# --- PHP temp/bytecode ---
*.cache
opcache/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Linux ---
*~

# --- IDEs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
nbproject/

# --- PHPUnit / test artifacts ---
.phpunit.result.cache
coverage/

# --- Backup files ---
*.bak
*.orig
*.swp
*.swo
claude-fleetforge-api-key

# --- DB snapshots (pre-demo restore points, seed dumps, etc.) ---
backups/

# --- Local secret scratch files (never commit) ---
samsara api
samsara_api*
*.api_key

# --- Claude Code working dirs ---
.claude/worktrees/
logs/
.claude/

# --- Operator's Claude Desktop prompt-review preset ---
# Personal tooling, not project state. Kept in working tree at repo root for
# operator convenience; not tracked. Added 2026-05-12 via S-FORK-CLOSE-RESOLVE
# after the file had sat untracked at repo root since 2026-05-06.
FleetForge Prompt Review.md
